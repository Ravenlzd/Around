ENV=development
DATABASE_URL=postgresql+asyncpg://around:around@localhost:5432/around
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# Local disk path where app/routers/media.py stores uploaded images.
# Read directly via os.environ (not through the Settings class in
# config.py, unlike everything else below) — defaults to
# /tmp/around_media if unset, which is fine for local dev but won't
# survive a container restart; set a persistent path in any real
# deployment.
MEDIA_ROOT=/tmp/around_media

# --- Reserved for future use — defined here, not yet consumed by any
# --- code (see README "What remains intentionally mocked"). Safe to
# --- leave blank; nothing currently reads these at runtime.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=

OBJECT_STORAGE_BUCKET=around-media
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=

CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
DEFAULT_CITY=Vilnius

# --- Email verification (app/email_sender.py, app/routers/auth.py) ---
# Provider-agnostic SMTP — works with Gmail (an app password, not your
# real password), SendGrid/Postmark/SES's SMTP relay, Resend's SMTP
# endpoint, or any other SMTP-speaking provider. Leave SMTP_HOST blank
# to run in log-only mode (no email actually sent, safe default — see
# email_sender.py). PUBLIC_APP_URL must be the real frontend origin
# (e.g. https://around.lt in production) — it's used to build the
# clickable link in the verification email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@around.lt
SMTP_USE_TLS=true
PUBLIC_APP_URL=http://localhost:5500
# Leave false until SMTP_* above is configured AND you've confirmed a
# real verification email arrives — turning this on with no working
# mail provider would lock every new signup out of creating events,
# sending friend requests, using I'm Free, and sending chat messages.
# See app/config.py's REQUIRE_EMAIL_VERIFICATION docstring.
REQUIRE_EMAIL_VERIFICATION=false
