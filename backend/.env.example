ENV=development
DATABASE_URL=postgresql+asyncpg://around:around@localhost:5432/around
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# Local disk path where app/routers/media.py stores uploaded images.
# Read directly via os.environ (not through the Settings class in
# config.py, unlike everything else below) — defaults to
# /tmp/around_media if unset, which is fine for local dev but won't
# survive a container restart; set a persistent path in any real
# deployment.
MEDIA_ROOT=/tmp/around_media

# --- Reserved for future use — defined here, not yet consumed by any
# --- code (see README "What remains intentionally mocked"). Safe to
# --- leave blank; nothing currently reads these at runtime.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=

OBJECT_STORAGE_BUCKET=around-media
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=

CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
DEFAULT_CITY=Vilnius
